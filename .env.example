# Tenacious Conversion Engine — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Kill switches (DEFAULT OFF — must be explicitly enabled for live outbound) ──
# Set to "true" to send real emails. Default routes to STAFF_SINK_EMAIL.
TENACIOUS_OUTBOUND_ENABLED=false
# Set to "true" to send real SMS. Default routes to STAFF_SINK_PHONE.
LIVE_SMS_ENABLED=false
# Sink destinations when kill switches are off
STAFF_SINK_EMAIL=sink@tenacious-dev.internal
STAFF_SINK_PHONE=+254700000000

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=outreach@tenacious.consulting
FROM_NAME=Tenacious Consulting
REPLY_TO=outreach@tenacious.consulting
RESEND_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/webhooks/email

# ── SMS (Africa's Talking Sandbox) ───────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=atsk_...
AT_SHORTCODE=

# ── CRM (HubSpot Developer Sandbox) ──────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na1-...
HUBSPOT_APP_ID=

# ── Calendar (Cal.com self-hosted) ────────────────────────────────────────────
CALCOM_BASE_URL=http://localhost:3000
CALCOM_PUBLIC_URL=http://localhost:3000
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=1
CALCOM_USER_ID=1

# ── Observability (Langfuse) ──────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
